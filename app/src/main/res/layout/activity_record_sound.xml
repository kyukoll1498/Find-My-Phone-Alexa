<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/image_back_ground" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_tittle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:singleLine="true"
            android:text="@string/record_sound"
            android:textColor="@color/color_274577"
            android:textSize="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_record_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_recorder"
        app:layout_constraintTop_toBottomOf="@id/layout_top">
        <ImageView
            android:id="@+id/iv_bg_record"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:alpha=".7"
            android:src="@drawable/ic_bg_recorder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tv_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:background="@drawable/bg_radius_100"
            android:backgroundTint="#5987FF"
            android:elevation="1dp"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:text="@string/next"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_record_controller"
            app:layout_constraintStart_toEndOf="@+id/iv_record_controller"
            app:layout_constraintTop_toTopOf="@+id/iv_record_controller" />

        <ImageView
            android:id="@+id/iv_record_controller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_micro_start"
            app:layout_constraintBottom_toBottomOf="@+id/iv_bg_record"
            app:layout_constraintEnd_toEndOf="@+id/iv_bg_record"
            app:layout_constraintStart_toStartOf="@+id/iv_bg_record"
            app:layout_constraintTop_toTopOf="@+id/iv_bg_record" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_28sdp"
            android:text="00:00"
            android:textSize="@dimen/_32sdp"
            app:layout_constraintEnd_toEndOf="@+id/iv_bg_record"
            app:layout_constraintStart_toStartOf="@+id/iv_bg_record"
            app:layout_constraintTop_toBottomOf="@+id/iv_record_controller" />

        <ImageView
            android:id="@+id/iv_restart_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_32sdp"
            android:src="@drawable/ic_restart_record"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_record_controller"
            app:layout_constraintEnd_toStartOf="@+id/iv_record_controller"
            app:layout_constraintTop_toTopOf="@+id/iv_record_controller" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_save_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintDimensionRatio="1:1"
        android:elevation="5dp"
        android:visibility="gone"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@id/layout_top">

        <ImageView
            android:id="@+id/iv_sound_avatar"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="@dimen/_90sdp"
            android:layout_marginTop="@dimen/_28sdp"
            android:src="@drawable/avatar_audio_default"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/edt_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:backgroundTint="#ACACAC"
            android:fontFamily="@font/inter_semibold"
            android:hint="@string/enter_name_sound"
            android:textColor="#404040"
            android:textColorHint="#ACACAC"
            android:layout_marginEnd="@dimen/_minus30sdp"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintEnd_toEndOf="@+id/iv_sound_avatar"
            app:layout_constraintStart_toStartOf="@+id/iv_sound_avatar"
            app:layout_constraintTop_toBottomOf="@+id/iv_sound_avatar" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_edit_name"
            app:layout_constraintBottom_toBottomOf="@+id/edt_name"
            app:layout_constraintEnd_toStartOf="@+id/edt_name"
            app:layout_constraintTop_toTopOf="@+id/edt_name" />

        <LinearLayout
            android:id="@+id/ll_audio_controller"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_radius_100"
            android:backgroundTint="#5987FF"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_name">

            <ImageView
                android:id="@+id/iv_player_controller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_pause" />

            <TextView
                android:id="@+id/tv_player_controller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="@string/play"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_radius_8"
        android:backgroundTint="#FF7A2F"
        android:fontFamily="@font/inter_bold"
        android:text="@string/save_sound"
        android:layout_marginBottom="@dimen/_12sdp"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="5dp"
        android:paddingVertical="@dimen/_8sdp"
        android:layout_marginHorizontal="@dimen/_48sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/fr_ad" />
    <FrameLayout
        android:id="@+id/fr_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/fake_loading" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>