<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewpager_onboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/fr_ad">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_25sdp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:paddingTop="@dimen/_15sdp"
            android:text="@string/where_do_you_usually_lose_your_phone"
            android:textColor="@color/color_404040"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:layout_marginBottom="@dimen/_52sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTextView">

            <GridLayout
                android:id="@+id/interestsGridLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:paddingBottom="16dp"
                android:rowOrderPreserved="false">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHome"
                    style="@style/InterestButtonStyle"
                    android:text="@string/home" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBedroom"
                    style="@style/InterestButtonStyle"
                    android:text="@string/bedroom" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSofa"
                    style="@style/InterestButtonStyle"
                    android:text="@string/sofa" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnWork"
                    style="@style/InterestButtonStyle"
                    android:text="@string/work" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGym"
                    style="@style/InterestButtonStyle"
                    android:text="@string/gym" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFriendHouse"
                    style="@style/InterestButtonStyle"
                    android:text="@string/friend_s_house" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCafe"
                    style="@style/InterestButtonStyle"
                    android:text="@string/caf" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOutdoors"
                    style="@style/InterestButtonStyle"
                    android:text="@string/outdoors" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSchool"
                    style="@style/InterestButtonStyle"
                    android:text="@string/school" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCar"
                    style="@style/InterestButtonStyle"
                    android:text="@string/car" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHotel"
                    style="@style/InterestButtonStyle"
                    android:text="@string/hotel" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEvents"
                    style="@style/InterestButtonStyle"
                    android:text="@string/events" />

            </GridLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_4sdp"
        android:fontFamily="@font/poppins_medium"
        android:includeFontPadding="false"
        android:text="@string/next"
        android:drawableEnd="@drawable/ic_ob_next"
        android:drawablePadding="@dimen/_6sdp"
        android:textColor="#303030"
        android:textSize="@dimen/_14sdp"
        app:layout_constraintHorizontal_bias="0.999"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/fr_ad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_1sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/fake_loading" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>