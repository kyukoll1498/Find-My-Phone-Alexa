<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewpager_onboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingBottom="@dimen/_25sdp"
            android:text="What's your interest in?"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/interestsGridLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:paddingBottom="16dp"
            android:rowOrderPreserved="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTextView">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAnimal"
                style="@style/InterestButtonStyle"
                android:text="@string/animal" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMusic"
                style="@style/InterestButtonStyle"
                android:text="@string/music" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnParty"
                style="@style/InterestButtonStyle"
                android:text="@string/party" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCar"
                style="@style/InterestButtonStyle"
                android:text="@string/car" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTravel"
                style="@style/InterestButtonStyle"
                android:text="@string/travel" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDrawing"
                style="@style/InterestButtonStyle"
                android:text="@string/drawing" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTechnology"
                style="@style/InterestButtonStyle"
                android:text="@string/technology" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGame"
                style="@style/InterestButtonStyle"
                android:text="@string/game" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnArt"
                style="@style/InterestButtonStyle"
                android:text="@string/art" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHomeDecor"
                style="@style/InterestButtonStyle"
                android:text="@string/home_decor" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFood"
                style="@style/InterestButtonStyle"
                android:text="@string/food" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFunny"
                style="@style/InterestButtonStyle"
                android:text="@string/funny" />
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/next"
        android:textColor="#303030"
        android:textSize="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@id/fr_ad"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/fr_ad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent=".3">

        <include layout="@layout/fake_load_fb" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>