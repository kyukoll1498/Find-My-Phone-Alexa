<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewpager_onboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingTop="@dimen/_20sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:text="@string/where_do_you_usually_lose_your_phone"
            android:textColor="@color/color_404040"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_25sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/interestsGridLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:paddingBottom="16dp"
            android:rowOrderPreserved="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTextView">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHome"
                style="@style/InterestButtonStyle"
                android:text="@string/home" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBedroom"
                style="@style/InterestButtonStyle"
                android:text="@string/bedroom" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSofa"
                style="@style/InterestButtonStyle"
                android:text="@string/sofa" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnWork"
                style="@style/InterestButtonStyle"
                android:text="@string/work" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGym"
                style="@style/InterestButtonStyle"
                android:text="@string/gym" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFriendHouse"
                style="@style/InterestButtonStyle"
                android:text="@string/friend_s_house" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCafe"
                style="@style/InterestButtonStyle"
                android:text="@string/caf" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOutdoors"
                style="@style/InterestButtonStyle"
                android:text="@string/outdoors" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSchool"
                style="@style/InterestButtonStyle"
                android:text="@string/school" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCar"
                style="@style/InterestButtonStyle"
                android:text="@string/car" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHotel"
                style="@style/InterestButtonStyle"
                android:text="@string/hotel" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEvents"
                style="@style/InterestButtonStyle"
                android:text="@string/events" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnShoppingMall"
                style="@style/InterestButtonStyle"
                android:text="@string/shopping_mall" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPark"
                style="@style/InterestButtonStyle"
                android:text="@string/park" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOthers"
                style="@style/InterestButtonStyle"
                android:text="@string/others" />
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/next"
        android:textColor="#303030"
        android:textSize="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@id/fr_ad"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/fr_ad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent=".3">

        <include layout="@layout/fake_load_fb" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>