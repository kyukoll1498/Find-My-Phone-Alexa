<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/bg_corner"
    android:backgroundTint="@color/white"
    android:paddingVertical="@dimen/_8sdp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_11sdp"
        android:paddingTop="@dimen/_4sdp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_9sdp"
            android:src="@drawable/ic_clap_notify" />

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/txt_clap_running_notify"
            android:textColor="#404040"
            android:textSize="@dimen/_13sdp"
            android:textStyle="bold" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="@dimen/_288sdp"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_25sdp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notification"
            android:backgroundTint="@color/orange_200"
            android:fontFamily="@font/inter_medium"
            android:padding="@dimen/_7sdp"
            android:text="@string/txt_touch_here_notify"
            android:textColor="@color/white"
            android:textSize="@dimen/_11sdp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/ic_round_notify"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_power_notify" />
    </RelativeLayout>
</LinearLayout>